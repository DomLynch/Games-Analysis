{"game":"ModernUO","category":"city-map-design","cell":20,"verdict":"STRONG","depth":"full","donor_path":"/mnt/frankendom-donors/ModernUO/Projects/UOContent/Regions/GuardedRegion.cs","licence":"GPL-3.0 (repo LICENSE, GNU GPL version 3)","licence_class":"copyleft","target_module":"origins/server/world-spawns.ts","parity_row":23,"pattern_tags":["grace-timer","group-refill","new:zone-rect-union","new:zone-rank-priority-depth"],"data_fields":[{"name":"guard_window","donor_constant":"15 s","unit":"s","where":"zone data","donor_ref":"/mnt/frankendom-donors/ModernUO/Projects/UOContent/Regions/GuardedRegion.cs:352"},{"name":"shout_range","donor_constant":"8 tiles","unit":"units","where":"engine constant","donor_ref":"/mnt/frankendom-donors/ModernUO/Projects/UOContent/Regions/GuardedRegion.cs:261"},{"name":"call_range","donor_constant":"14 tiles","unit":"units","where":"engine constant","donor_ref":"/mnt/frankendom-donors/ModernUO/Projects/UOContent/Regions/GuardedRegion.cs:303"},{"name":"guard_recruit_range","donor_constant":"15 tiles","unit":"units","where":"engine constant","donor_ref":"/mnt/frankendom-donors/ModernUO/Projects/UOContent/Mobiles/Guards/BaseGuard.cs:30"},{"name":"guards_per_call","donor_constant":"1","unit":"count","where":"engine constant","donor_ref":"/mnt/frankendom-donors/ModernUO/Projects/UOContent/Mobiles/Guards/BaseGuard.cs:20"},{"name":"reinforcement_waves","donor_constant":"3 ticks","unit":"count","where":"engine constant","donor_ref":"/mnt/frankendom-donors/ModernUO/Projects/UOContent/Mobiles/Guards/BaseGuard.cs:216"},{"name":"reinforcement_first_delay","donor_constant":"2.5 s","unit":"s","where":"engine constant","donor_ref":"/mnt/frankendom-donors/ModernUO/Projects/UOContent/Mobiles/Guards/BaseGuard.cs:216"},{"name":"reinforcement_interval","donor_constant":"1.0 s","unit":"s","where":"engine constant","donor_ref":"/mnt/frankendom-donors/ModernUO/Projects/UOContent/Mobiles/Guards/BaseGuard.cs:216"},{"name":"zone_priority","donor_constant":"50 (de