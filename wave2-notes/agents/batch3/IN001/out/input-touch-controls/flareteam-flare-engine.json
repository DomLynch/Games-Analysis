{"game":"flareteam-flare-engine","category":"input-touch-controls","cell":3,"verdict":"STRONG","depth":"full","donor_path":"/mnt/frankendom-donors/flareteam-flare-engine","licence":"GPL-3.0 (COPYING: GNU GENERAL PUBLIC LICENSE Version 3; MenuTouchControls.cpp header: version 3 or any later version)","licence_class":"copyleft","target_module":"src/fight/input.ts","parity_row":5,"pattern_tags":["hysteresis","new:tap-to-move-hysteresis","new:digital-pad-square-deadzone","new:press-lock","new:slow-repeat-accelerating","compute-budget","new:shared-pointer-multitouch-defect","new:digital-gamepad-threshold"],"data_fields":[{"name":"tap_start_threshold","donor_constant":"0.75","unit":"units","where":"engine constant","donor_ref":"/mnt/frankendom-donors/flareteam-flare-engine/src/EngineSettings.cpp:94"},{"name":"tap_stop_threshold","donor_constant":"0.25","unit":"units","where":"engine constant","donor_ref":"/mnt/frankendom-donors/flareteam-flare-engine/src/EngineSettings.cpp:93"},{"name":"tap_arrive_speed_multiplier","donor_constant":"2","unit":"ratio","where":"engine constant","donor_ref":"/mnt/frankendom-donors/flareteam-flare-engine/src/Avatar.cpp:1215"},{"name":"pad_radius_fraction_of_view_h","donor_constant":"1/4 (times touch scale)","unit":"ratio","where":"engine constant","donor_ref":"/mnt/frankendom-donors/flareteam-flare-engine/src/MenuTouchControls.cpp:51"},{"name":"pad_deadzone_fraction_of_view_h","donor_constant":"1/20 (times touch scale)","unit":"ratio","where":"engine constant","donor_ref":"/mnt/frankendom-donors/flareteam-flare-engine/src/MenuTouchControls.cpp:54"},{"name":"action_radius_fraction_of_view_h","donor_constant":"1/6 (times touch scale)","unit":"ratio","where":"engine constant","donor_ref":"/mnt/frankendom-donors/flareteam-flare-engine/src/MenuTouchControls.cpp:56"},{"name":"touch_scale","donor_constant":"1.0 (slider 0.75 to 1.25)","unit":"ratio","where":"engine constant","donor_ref":"/mnt/frankendom-donors/flareteam-flare-engine/src/Settings.cpp: