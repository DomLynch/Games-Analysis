ards/BaseGuard.cs:152"}, {"name": "headClaimKarma", "donor_constant": "20 karma (AwardKarma(from, 20, true))", "unit": "count", "where": "engine constant", "donor_ref": "/mnt/frankendom-donors/ModernUO/Projects/UOContent/Mobiles/Guards/BaseGuard.cs:176"}, {"name": "karmaClamp", "donor_constant": "-15000 to +15000 (MinKarma, MaxKarma)", "unit": "count", "where": "engine constant", "donor_ref": "/mnt/frankendom-donors/ModernUO/Projects/UOContent/Misc/Titles.cs:13"}, {"name": "killKarmaPerMurder", "donor_constant": "-2000 AOS, -1000 otherwise (per kill, on report)", "unit": "count", "where": "engine constant", "donor_ref": "/mnt/frankendom-donors/ModernUO/Projects/UOContent/Engines/Player Murder System/PlayerMurderSystem.cs:301"}], "best_idea": "A guard call is a short window that opens on the first offence and is re-armed by each new offence (without calling guards again), and guards already near the target are reused before any new guard is spawned, up to a per-target count from zone data.", "decision": "adapt", "decision_why": "Keep the 2-minute hostile window and the reuse-first guard dispatch as zone data; reject the victim-filed murder report because kills must be server-verified under our rulings, so the murder count comes from the server, not a gump.", "decision_status": "proposed", "acceptance": "A player who attacks an innocent in an open zone is flagged for 2 minutes; a guard arrives within 15 seconds when a witness NPC is within 8 tiles; a second offence inside the window does not add a second guard; a server test asserts that guards on one target never exceed guardCap from zone data and that an idle guard is re-focused before a new one spawns."}