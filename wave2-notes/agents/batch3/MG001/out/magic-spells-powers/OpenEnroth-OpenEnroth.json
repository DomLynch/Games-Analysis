Enroth-OpenEnroth/src/Engine/Spells/CastSpellInfo.cpp:233"},{"name":"curse_failure_recovery","donor_constant":"100 ticks","unit":"ticks","where":"engine constant","donor_ref":"/mnt/frankendom-donors/OpenEnroth-OpenEnroth/src/Engine/Spells/CastSpellInfo.cpp:50"},{"name":"party_halving_checks","donor_constant":"4 (maximum consecutive halvings)","unit":"count","where":"engine constant","donor_ref":"/mnt/frankendom-donors/OpenEnroth-OpenEnroth/src/Engine/Objects/Character.cpp:1189"},{"name":"halving_pass_threshold","donor_constant":"30 (check at or above 30 halves)","unit":"units","where":"engine constant","donor_ref":"/mnt/frankendom-donors/OpenEnroth-OpenEnroth/src/Engine/Objects/Character.cpp:1190"},{"name":"halving_divider_base","donor_constant":"luck bonus + resist + 30","unit":"units","where":"engine constant","donor_ref":"/mnt/frankendom-donors/OpenEnroth-OpenEnroth/src/Engine/Objects/Character.cpp:1186"},{"name":"monster_immune_resist","donor_constant":"200 or more is immune","unit":"units","where":"zone data","donor_ref":"/mnt/frankendom-donors/OpenEnroth-OpenEnroth/src/Engine/Objects/Actor.cpp:3816"},{"name":"monster_gate_pass_threshold","donor_constant":"random(level/4 + resist + 30) < 30","unit":"units","where":"zone data","donor_ref":"/mnt/frankendom-donors/OpenEnroth-OpenEnroth/src/Engine/Objects/Actor.cpp:3817"},{"name":"mind_charm_duration_per_level","donor_constant":"10 game minutes per skill level at master (5 at expert)","unit":"s","where":"engine constant","donor_ref":"/mnt/frankendom-donors/OpenEnroth-OpenEnroth/src/Engine/Spells/CastSpellInfo.cpp:638"},{"name":"game_time_per_real_second","donor_constant":"30","unit":"ratio","where":"engine constant","donor_ref":"/mnt/frankendom-donors/OpenEnroth-OpenEnroth/src/Core/Time/Duration.h:29"}],"best_idea":"Keep spell cost and recovery in one row per mastery, so a higher mastery shortens the recovery instead of raising the cost, and a failed cast uses a fixed fraction of that recovery.","decision":"adapt","decision_why":"The per-mastery row shape gives the specials table a clear progression (recovery shrinks with mastery) and the failure fraction is a tuning knob; take the shape into src/fight/spell-table.ts with recovery in seconds, fix the cursed-failure return (it stops the rest of the cast queue), and leave out the luck table and the mind durations until Frankendom has PvP consent rules.","decision_status":"proposed","acceptance":"A server test with a Fire Bolt row of recovery 110, 110, 100, 90 ticks asserts a grandmaster cast waits 0.70 s, a failed cast waits half of that, and a second queued cast still resolves after a cursed failure."}
